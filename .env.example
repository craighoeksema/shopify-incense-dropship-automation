NODE_ENV=development
PORT=3000

# Shopify custom app credentials.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_SECRET=replace_with_app_client_secret

# shippingLabelPurchase is available in Shopify Admin GraphQL 2026-07.
SHOPIFY_API_VERSION=2026-07

# Product/order matching and package config.
AUTOMATION_CONFIG_PATH=./config/automation.example.json

# Storage. Use file for local development, postgres for production.
STORE_DRIVER=file
FILE_STORE_PATH=./data/automation-store.json
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopify_incense_automation
POSTGRES_AUTO_MIGRATE=false

# Internal replay endpoint auth.
INTERNAL_API_TOKEN=replace_with_long_random_value

# Dry-run mode. When true, the worker matches orders and reports what it WOULD
# have done, but never purchases a paid label and never emails the vendor.
# Use this for a validation period before going live.
DRY_RUN=false
# Recipients for "[DRY RUN] Would have purchased..." emails (comma-separated).
# Only used when DRY_RUN=true. Requires SMTP settings below.
DRY_RUN_EMAIL_TO=

# Optional internal Slack completion/failure notifications.
SLACK_WEBHOOK_URL=

# Optional SMTP email for vendor and/or internal notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shopify Automation <automation@example.com>"
VENDOR_EMAIL_TO=sales@cinnamonprojects.com
INTERNAL_EMAIL_TO=

# Worker settings.
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=5
